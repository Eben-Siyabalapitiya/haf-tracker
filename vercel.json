{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build_site.py",
  "outputDirectory": "_site",
  "installCommand": "",
  "framework": null,
  "ignoreCommand": "bash scripts/vercel_ignore.sh",
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
